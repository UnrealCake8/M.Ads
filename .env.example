MADS_ADMIN_KEY=change-me
NEXT_PUBLIC_MADS_BASE_URL=http://localhost:3000

# Shared Supabase project is supported. M Ads only uses tables prefixed mads_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The app also accepts NEXT_PUBLIC_SUPABASE_URL for the URL and
# SUPABASE_SECRET_KEY for newer Supabase secret keys. Never expose the
# service-role/secret key through a NEXT_PUBLIC_ variable.
